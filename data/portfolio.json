{
 "artifact": "kalshi-demo-ci-paper-portfolio",
 "version": 1,
 "engine": {
  "name": "scripts/portfolio_engine.py",
  "version": 1,
  "bankroll_start_usd": 1000.0,
  "per_trade_usd": 25.0,
  "max_open_positions": 8,
  "alert_threshold_usd": 0.1,
  "fee_rule": "taker: fees = roundup(M x 0.07 x C x P x (1-P)) with M=1 (https://kalshi.com/docs/kalshi-fee-schedule.pdf, effective 2026-07-07). The model fee is rounded up to 6 decimals - the official Fee Rounding page states 'trade fee = ceil_6dp(model fee)' - and the resulting balance change is then floored to the $0.01 alignment used for non-direct members, with the difference booked as the rounding fee (https://docs.kalshi.com/getting_started/fee_rounding). Settlement is free: 'There is no settlement fee.' Resting-order (maker) fees are not modeled because every simulated fill crosses the spread.",
  "score_formula": "score = 0.30*min(vol24/2000,1) + 0.25*min(vol/10000,1) + 0.20*max(0,1-spread/0.15) + 0.25*min(|delta|/0.25,1)",
  "min_model_score": 0.45,
  "rules": {
   "momentum": {
    "enter": "a sampled >= $0.10 move whose model score >= 0.45 and YES spread <= $0.06; buy the side the move points to (up -> YES, down -> NO)",
    "exit": "take-profit +$0.15, stop-loss -$0.10, else max 12 samples (~6 h) at the official bid, else settlement",
    "take_profit_bits": 1500,
    "stop_loss_bits": 1000,
    "max_samples": 12,
    "max_spread_bits": 600,
    "min_score": 0.45
   },
   "fade": {
    "enter": "a sampled >= $0.10 move whose model score < 0.45, spread <= $0.04 and 24 h volume >= 100 contracts; buy the opposite side",
    "exit": "take-profit +$0.08, stop-loss -$0.08, else max 4 samples (~2 h) at the official bid, else settlement",
    "take_profit_bits": 800,
    "stop_loss_bits": 800,
    "max_samples": 4,
    "max_spread_bits": 400,
    "min_vol24h_contracts": 100
   },
   "breakout": {
    "enter": "last price crosses the 50c line between two samples, with 24 h volume >= 500 contracts and spread <= $0.05; buy the side it crossed to",
    "exit": "take-profit +$0.12, stop-loss -$0.10, else max 48 samples (~24 h) at the official bid, else settlement",
    "take_profit_bits": 1200,
    "stop_loss_bits": 1000,
    "max_samples": 48,
    "max_spread_bits": 500,
    "min_vol24h_contracts": 500
   },
   "harvest": {
    "enter": "last price between $0.90 and $0.99, spread <= $0.03, market closes within 72 h; buy YES to settlement (no take-profit, no stop)",
    "exit": "settlement only: $1.00 per winning contract, $0.00 per losing contract; no settlement fee",
    "min_price_bits": 9000,
    "max_price_bits": 9900,
    "max_spread_bits": 300,
    "max_close_hours": 72,
    "cooldown_hours": 6
   }
  }
 },
